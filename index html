        nav a { color: #ccc; text-decoration: none; font-size: 0.95rem; transition: color 0.2s; }
        nav a:hover { color: #f0a500; }
        .cta-btn { background: #f0a500; color: #1a1a2e; padding: 0.6rem 1.5rem; border-radius: 4px; font-weight: 600; text-decoration: none; }

        /* Hero */
        .hero { background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%); color: #fff; padding: 6rem 5% 5rem; text-align: center; }
        .hero h1 { font-size: 2.8rem; margin-bottom: 1rem; line-height: 1.2; }
        .hero h1 span { color: #f0a500; }
        .hero p { font-size: 1.2rem; color: #aaa; max-width: 700px; margin: 0 auto 2rem; }
        .hero-stats { display: flex; justify-content: center; gap: 4rem; margin-top: 3rem; flex-wrap: wrap; }
        .stat-item h3 { font-size: 2rem; color: #f0a500; }
        .stat-item p { font-size: 0.9rem; color: #888; }

        /* Services */
        .section { padding: 5rem 5%; }
        .section-title { text-align: center; font-size: 2rem; margin-bottom: 0.5rem; color: #1a1a2e; }
        .section-sub { text-align: center; color: #777; margin-bottom: 3rem; }
        .services-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem; max-width: 1200px; margin: 0 auto; }
        .service-card { background: #f8f9fa; padding: 2rem; border-radius: 8px; border-left: 4px solid #f0a500; transition: transform 0.2s, box-shadow 0.2s; }
        .service-card:hover { transform: translateY(-4px); box-shadow: 0 8px 25px rgba(0,0,0,0.1); }
        .service-card h3 { margin-bottom: 0.5rem; color: #1a1a2e; font-size: 1.1rem; }
        .service-card p { font-size: 0.9rem; color: #666; }

        /* Why Us */
        .why-us { background: #1a1a2e; color: #fff; padding: 5rem 5%; }
        .why-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 2rem; max-width: 1100px; margin: 2rem auto 0; }
        .why-item { text-align: center; padding: 1.5rem; }
        .why-item .icon { font-size: 2.5rem; margin-bottom: 1rem; }
        .why-item h4 { color: #f0a500; margin-bottom: 0.5rem; }
        .why-item p { font-size: 0.9rem; color: #aaa; }

        /* Contact / Footer */
        footer { background: #0f0f1a; color: #888; padding: 3rem 5%; text-align: center; }
        .contact-info { display: flex; justify-content: center; gap: 3rem; flex-wrap: wrap; margin-bottom: 2rem; }
        .contact-info div { color: #ccc; }
        .contact-info strong { color: #f0a500; display: block; margin-bottom: 0.3rem; }
        .footer-copy { border-top: 1px solid #222; padding-top: 1.5rem; font-size: 0.85rem; }

        @media (max-width: 768px) {
            .hero h1 { font-size: 1.8rem; }
            nav ul { display: none; }
            .hero-stats { gap: 2rem; }
        }
    </style>
</head>
