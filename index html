        /* Navigation */
        nav { background: #1a1a2e; padding: 1rem 5%; display: flex; justify-content: space-between; align-items: center; position: sticky; top: 0; z-index: 100; }
        .logo { color: #fff; font-size: 1.5rem; font-weight: 700; letter-spacing: 1px; }
